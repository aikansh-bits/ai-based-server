# ─────────────────────────────────────────────────────────────────────────────
# Service
# ─────────────────────────────────────────────────────────────────────────────
SERVICE_NAME=ai-based-server
SERVICE_VERSION=1.0.0
ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Comma-separated origins. Use "*" only in development.
CORS_ORIGINS=*

# ─────────────────────────────────────────────────────────────────────────────
# Model
# ─────────────────────────────────────────────────────────────────────────────
# Path to the persisted Isolation Forest model artefact. Generated by
# `python -m app.ml.train`.
MODEL_PATH=./models/isolation_forest.joblib

# Score threshold above which a request is flagged as an anomaly.
# Scores are calibrated to [0, 1] where 1.0 is "definitely anomalous".
ANOMALY_THRESHOLD=0.55

# Optional simulated inference latency (ms). Set to 0 to disable. Useful when
# running experiments to study the latency-accuracy trade-off without having
# to swap to a heavier model.
SIMULATED_LATENCY_MS=0

# Optional: jitter added to simulated latency, +/- this many ms.
SIMULATED_LATENCY_JITTER_MS=0
